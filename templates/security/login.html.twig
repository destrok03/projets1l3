<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion | Brasil Burger</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }
        body {
            background: linear-gradient(135deg, #ff9a56 0%, #ff6b35 50%, #f7931e 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .login-container {
            width: 100%;
            max-width: 420px;
        }
        .login-card {
            background: white;
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        }
        .logo-container {
            text-align: center;
            margin-bottom: 30px;
        }
        .logo-icon {
            font-size: 64px;
            display: block;
            margin-bottom: 10px;
        }
        .logo-container h1 {
            font-size: 28px;
            font-weight: 700;
            color: #333;
            margin-bottom: 5px;
        }
        .logo-container p {
            color: #666;
            font-size: 14px;
        }
        .form-label {
            font-weight: 500;
            color: #333;
            margin-bottom: 8px;
        }
        .input-group {
            border: 2px solid #e9ecef;
            border-radius: 12px;
            overflow: hidden;
            transition: border-color 0.3s;
        }
        .input-group:focus-within {
            border-color: #ff6b35;
        }
        .input-group-text {
            background: white;
            border: none;
            padding-left: 16px;
        }
        .form-control {
            border: none;
            padding: 14px 16px;
            font-size: 15px;
        }
        .form-control:focus {
            box-shadow: none;
        }
        .btn-login {
            background: linear-gradient(135deg, #ff6b35, #f7931e);
            border: none;
            padding: 14px;
            font-weight: 600;
            font-size: 16px;
            border-radius: 12px;
            width: 100%;
            color: white;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 107, 53, 0.4);
            color: white;
        }
        .demo-info {
            background: #f8f9fa;
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 13px;
            text-align: center;
            margin-top: 24px;
            color: #666;
        }
        .demo-info strong {
            color: #ff6b35;
        }
        .form-check-label {
            font-size: 14px;
            color: #666;
        }
        .forgot-password {
            font-size: 14px;
            color: #ff6b35;
            text-decoration: none;
        }
        .forgot-password:hover {
            text-decoration: underline;
            color: #e55a2b;
        }
        .password-toggle {
            cursor: pointer;
            padding-right: 16px;
        }
        .alert {
            border-radius: 12px;
            border: none;
            font-size: 14px;
        }
        .copyright {
            text-align: center;
            margin-top: 24px;
            color: rgba(255,255,255,0.8);
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="logo-container">
                <span class="logo-icon">🍔</span>
                <h1>Brasil Burger</h1>
                <p>Espace Administration</p>
            </div>

            {% if error %}
                <div class="alert alert-danger mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-envelope text-muted"></i>
                        </span>
                        <input type="email" class="form-control" id="email" name="email" 
                               value="{{ last_username }}" placeholder="admin@brasil.com" required autofocus>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock text-muted"></i>
                        </span>
                        <input type="password" class="form-control" id="password" name="password" 
                               placeholder="••••••••" required>
                        <span class="input-group-text password-toggle" onclick="togglePassword()">
                            <i class="fas fa-eye text-muted" id="toggleIcon"></i>
                        </span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="remember_me" name="_remember_me">
                        <label class="form-check-label" for="remember_me">Se souvenir de moi</label>
                    </div>
                    <a href="#" class="forgot-password">Mot de passe oublié ?</a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn-login">
                    <i class="fas fa-sign-in-alt me-2"></i> Se connecter
                </button>
            </form>

            <div class="demo-info">
                <i class="fas fa-info-circle me-1"></i>
                <strong>Demo:</strong> admin@brasil.com / admin123
            </div>
        </div>

        <p class="copyright">
            © {{ "now"|date("Y") }} Brasil Burger. Tous droits réservés.
        </p>
    </div>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>

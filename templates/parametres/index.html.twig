{% extends 'base.html.twig' %}

{% block title %}Paramètres{% endblock %}

{% block body %}
<div class="parametres-page">
    <div class="page-header mb-4">
        <h1 class="page-title">Paramètres</h1>
        <p class="text-muted">Gérez votre profil et vos préférences</p>
    </div>

    <div class="row g-4">
        <!-- Profil -->
        <div class="col-lg-6">
            <div class="card card-elevated">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-user text-primary me-2"></i>
                        Mon profil
                    </h5>
                </div>
                <div class="card-body">
                    <form action="{{ path('app_parametres_profil') }}" method="POST">
                        <div class="mb-3">
                            <label for="nom_complet" class="form-label">Nom complet</label>
                            <input type="text" class="form-control" id="nom_complet" name="nom_complet" 
                                   value="{{ app.user.nomComplet }}" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" 
                                   value="{{ app.user.email }}" required>
                        </div>

                        <div class="mb-3">
                            <label for="telephone" class="form-label">Téléphone</label>
                            <input type="tel" class="form-control" id="telephone" name="telephone" 
                                   value="{{ app.user.telephone }}" placeholder="77 123 45 67">
                        </div>
                        
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Enregistrer
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Mot de passe -->
        <div class="col-lg-6">
            <div class="card card-elevated">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-lock text-warning me-2"></i>
                        Changer le mot de passe
                    </h5>
                </div>
                <div class="card-body">
                    <form action="{{ path('app_parametres_password') }}" method="POST">
                        <div class="mb-3">
                            <label for="current_password" class="form-label">Mot de passe actuel</label>
                            <input type="password" class="form-control" id="current_password" 
                                   name="current_password" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="new_password" class="form-label">Nouveau mot de passe</label>
                            <input type="password" class="form-control" id="new_password" 
                                   name="new_password" required minlength="6">
                            <small class="text-muted">Minimum 6 caractères</small>
                        </div>
                        
                        <div class="mb-3">
                            <label for="confirm_password" class="form-label">Confirmer le mot de passe</label>
                            <input type="password" class="form-control" id="confirm_password" 
                                   name="confirm_password" required minlength="6">
                        </div>
                        
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-key me-2"></i>Modifier le mot de passe
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Informations du compte -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card card-elevated">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle text-info me-2"></i>
                        Informations du compte
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <p class="text-muted mb-1">Rôle</p>
                            <p class="fw-medium">
                                {% for role in app.user.roles %}
                                    <span class="badge-status info me-1">{{ role }}</span>
                                {% endfor %}
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p class="text-muted mb-1">Statut</p>
                            <p class="fw-medium">
                                {% if app.user.actif %}
                                    <span class="badge-status success">Actif</span>
                                {% else %}
                                    <span class="badge-status danger">Inactif</span>
                                {% endif %}
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p class="text-muted mb-1">Membre depuis</p>
                            <p class="fw-medium">
                                {% if app.user.createdAt %}
                                    {{ app.user.createdAt|date('d/m/Y') }}
                                {% else %}
                                    -
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

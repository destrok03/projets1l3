{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
<div class="dashboard">
    <div class="page-header mb-4">
        <h1 class="page-title">Tableau de bord</h1>
        <p class="text-muted">Bienvenue, {{ app.user.prenom }} ! Voici un aperçu de votre activité du jour.</p>
    </div>

    <!-- KPIs Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card card-elevated h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h3 class="mb-0 fw-bold">{{ stats.commandesEnCours }}</h3>
                        <p class="text-muted mb-0 small">Commandes en cours</p>
                    </div>
                    <div class="stat-icon-box stat-icon-warning ms-3">
                        <i class="fas fa-shopping-cart fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100 card-elevated">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h3 class="mb-0 fw-bold">{{ stats.commandesValidees }}</h3>
                        <p class="text-muted mb-0 small">Commandes validées</p>
                    </div>
                    <div class="stat-icon-box stat-icon-success ms-3">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100 card-elevated">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h3 class="mb-0 fw-bold">{{ stats.commandesAnnulees }}</h3>
                        <p class="text-muted mb-0 small">Commandes annulées</p>
                    </div>
                    <div class="stat-icon-box stat-icon-danger ms-3">
                        <i class="fas fa-times-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100 card-elevated">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h3 class="mb-0 fw-bold">{{ stats.recettesJournalieres|number_format(0, ',', ' ') }}</h3>
                        <p class="text-muted mb-0 small">Recettes du jour (FCFA)</p>
                    </div>
                    <div class="stat-icon-box stat-icon-primary ms-3">
                        <i class="fas fa-money-bill-wave fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Burgers les plus vendus (full width) -->
        <div class="col-12">
            <div class="card card-elevated">
                <div class="card-header bg-white border-0 py-3 d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 d-flex align-items-center gap-2">
                        <i class="fas fa-fire text-warning"></i>
                        Burgers les plus vendus
                    </h5>
                    <a href="#" class="see-all-link small">Voir plus</a>
                </div>
                <div class="card-body">
                    {% if stats.topBurgers|length > 0 %}
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="list-group">
                                    {% for burger in stats.topBurgers %}
                                    <div class="list-group-item d-flex align-items-center justify-content-between py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="rank-badge-lg {{ loop.index == 1 ? 'top-3' : '' }} me-3">{{ loop.index }}</div>
                                            <div class="fw-medium">{{ burger.nom }}</div>
                                        </div>
                                        <div class="text-danger fw-bold">{{ burger.totalVentes }} vendus</div>
                                    </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-chart-bar fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">Aucune vente aujourd'hui</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <!-- Commandes récentes (full width) -->
        <div class="col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 d-flex align-items-center gap-2">
                        <i class="fas fa-clock text-info"></i>
                        Commandes récentes
                    </h5>
                    <a href="{{ path('app_commande_list') }}" class="see-all-link text-danger">
                        Voir tout <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    {% if stats.commandesRecentes|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0">ID</th>
                                        <th class="border-0">Client</th>
                                        <th class="border-0">Montant</th>
                                        <th class="border-0">Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for commande in stats.commandesRecentes %}
                                    <tr>
                                        <td>
                                            <span class="fw-medium">{{ commande.numero }}</span>
                                        </td>
                                        <td>{{ commande.client.nomComplet }}</td>
                                        <td>{{ commande.montantTotal|number_format(0, ',', ' ') }} FCFA</td>
                                        <td>
                                            <span class="badge-status {{ commande.statutBadgeClass }} rounded-pill">{{ commande.statutLabel }}</span>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-inbox fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">Aucune commande récente</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

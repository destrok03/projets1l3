{% if nbrePages > 1 %}
<nav aria-label="Pagination">
    <ul class="pagination pagination-sm justify-content-center mb-0">
        {# Previous button #}
        <li class="page-item {{ pageEncours <= 1 ? 'disabled' : '' }}">
            <a class="page-link" href="{{ path(route, app.request.query.all|merge({'page': pageEncours - 1})) }}" aria-label="Précédent">
                <i class="fas fa-chevron-left"></i>
            </a>
        </li>
        
        {# Page numbers #}
        {% set startPage = max(1, pageEncours - 2) %}
        {% set endPage = min(nbrePages, pageEncours + 2) %}
        
        {% if startPage > 1 %}
            <li class="page-item">
                <a class="page-link" href="{{ path(route, app.request.query.all|merge({'page': 1})) }}">1</a>
            </li>
            {% if startPage > 2 %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}
        {% endif %}
        
        {% for i in startPage..endPage %}
            <li class="page-item {{ i == pageEncours ? 'active' : '' }}">
                <a class="page-link" href="{{ path(route, app.request.query.all|merge({'page': i})) }}">{{ i }}</a>
            </li>
        {% endfor %}
        
        {% if endPage < nbrePages %}
            {% if endPage < nbrePages - 1 %}
                <li class="page-item disabled"><span class="page-link">...</span></li>
            {% endif %}
            <li class="page-item">
                <a class="page-link" href="{{ path(route, app.request.query.all|merge({'page': nbrePages})) }}">{{ nbrePages }}</a>
            </li>
        {% endif %}
        
        {# Next button #}
        <li class="page-item {{ pageEncours >= nbrePages ? 'disabled' : '' }}">
            <a class="page-link" href="{{ path(route, app.request.query.all|merge({'page': pageEncours + 1})) }}" aria-label="Suivant">
                <i class="fas fa-chevron-right"></i>
            </a>
        </li>
    </ul>
</nav>
{% endif %}

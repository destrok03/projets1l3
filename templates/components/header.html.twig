<header class="main-header">
    <div class="header-left">
        <button class="btn btn-link sidebar-toggle-btn d-lg-none" id="sidebarToggleBtn">
            <i class="fas fa-bars"></i>
        </button>
        <nav aria-label="breadcrumb" class="d-none d-md-block">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">Brasil Burger</li>
                <li class="breadcrumb-item active">{% block breadcrumb %}Dashboard{% endblock %}</li>
            </ol>
        </nav>
    </div>
    
    <div class="header-right">
        <div class="header-actions">
            {# Notifications removed as requested #}
            
            {# Theme toggle removed as requested #}

            <div class="dropdown">
                <button class="btn btn-ghost d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                    <div class="user-avatar-small me-2">
                        <i class="fas fa-user"></i>
                    </div>
                    <span class="d-none d-md-inline">{{ app.user.nomComplet }}</span>
                    <i class="fas fa-chevron-down ms-2 small"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="{{ path('app_parametres') }}">
                        <i class="fas fa-user me-2"></i> Mon profil
                    </a></li>
                    <li><a class="dropdown-item" href="{{ path('app_parametres') }}">
                        <i class="fas fa-cog me-2"></i> Paramètres
                    </a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                        <i class="fas fa-sign-out-alt me-2"></i> Déconnexion
                    </a></li>
                </ul>
            </div>
        </div>
    </div>
</header>

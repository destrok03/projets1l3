@model BrasilBurger.Models.Commande

@{
    ViewData["Title"] = "Détails commande";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Commande #@Model.Id</h2>
        <a class="btn btn-outline-secondary" asp-controller="Orders" asp-action="Index">Retour</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="checkout-card">
                <div class="checkout-header">
                    <h5 class="mb-0">Articles</h5>
                </div>
                <div class="p-4">
                    @foreach (var l in Model.Lignes)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">
                            <div>
                                <strong>@l.Produit.Nom</strong>
                                <div class="text-muted-brasil small">@l.Quantite x @l.PrixUnitaire.ToString("N0") FCFA</div>
                            </div>
                            <div class="fw-semibold">@l.SousTotal.ToString("N0") FCFA</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="summary-card">
                <h5 class="mb-4">Résumé</h5>
                <div class="d-flex justify-content-between mb-2"><span>Statut</span><span class="fw-semibold">@Model.Statut</span></div>
                <div class="d-flex justify-content-between mb-2"><span>Type</span><span class="fw-semibold">@Model.TypeLivraison</span></div>
                <div class="d-flex justify-content-between mb-2"><span>Frais livraison</span><span class="fw-semibold">@Model.FraisLivraison.ToString("N0") FCFA</span></div>
                <hr />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="h5 mb-0">Total</span>
                    <span class="h4 text-brasil mb-0">@Model.MontantTotal.ToString("N0") FCFA</span>
                </div>

                @if (Model.Paiement == null)
                {
                    <div class="d-grid mt-4">
                        <a class="btn btn-brasil btn-lg" asp-controller="Checkout" asp-action="Payment" asp-route-id="@Model.Id">Payer</a>
                    </div>
                }
                else
                {
                    <div class="alert alert-success mt-4 mb-0">
                        Payé par <strong>@Model.Paiement.ModePaiement</strong> — Réf: <strong>@Model.Paiement.ReferenceTransaction</strong>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-3 text-muted-brasil small">
                        <strong>Notes :</strong> @Model.Notes
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@model PanierViewModel
@{
    ViewData["Title"] = "Mon Panier";
}

<div class="container py-5">
    <a asp-controller="Catalogue" asp-action="Index" class="link-back mb-4 d-inline-flex"><i
            class="fas fa-arrow-left"></i> Continuer les achats</a>

    @if (Model.Panier.NombreItems > 0)
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="checkout-card">
                    <div class="checkout-header">
                        <h2 class="fw-bold mb-0">Votre panier</h2>
                        <span class="text-muted-brasil">@Model.Panier.NombreItems article(s)</span>
                    </div>
                    <div class="checkout-items">
                        @foreach (var item in Model.Panier.Items)
                        {
                            <div class="checkout-item">
                                @if (!string.IsNullOrWhiteSpace(item.Image))
                                {
                                    <img src="@item.Image" alt="@item.Nom" class="thumb-rounded" />
                                }
                                else
                                {
                                    <div class="thumb-rounded d-flex align-items-center justify-content-center bg-light">
                                        <i class="fas fa-hamburger text-muted"></i>
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="fw-semibold mb-1">@item.Nom</h5>
                                            <span class="text-muted-brasil small">@item.Prix.ToString("N0") FCFA</span>
                                        </div>
                                        <form asp-controller="Panier" asp-action="Supprimer" method="post">
                                            <input type="hidden" name="produitId" value="@item.ProduitId" />
                                            <button type="submit" class="btn btn-link text-muted"
                                                aria-label="Retirer du panier">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <div class="quantity-control">
                                            <form asp-controller="Panier" asp-action="Modifier" method="post">
                                                <input type="hidden" name="produitId" value="@item.ProduitId" />
                                                <input type="hidden" name="quantite" value="@(item.Quantite - 1)" />
                                                <button type="submit" @(item.Quantite <= 1 ? "disabled" :
                                                                                                                  string.Empty)>-</button>
                                            </form>
                                            <span>@item.Quantite</span>
                                            <form asp-controller="Panier" asp-action="Modifier" method="post">
                                                <input type="hidden" name="produitId" value="@item.ProduitId" />
                                                <input type="hidden" name="quantite" value="@(item.Quantite + 1)" />
                                                <button type="submit">+</button>
                                            </form>
                                        </div>
                                        <strong>@item.SousTotal.ToString("N0") FCFA</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-between align-items-center px-4 pb-4">
                        <form asp-controller="Panier" asp-action="Vider" method="post">
                            <button type="submit" class="btn btn-link text-danger"
                                onclick="return confirm('Êtes-vous sûr de vouloir vider le panier ?');">
                                <i class="fas fa-trash me-2"></i>Vider le panier
                            </button>
                        </form>
                        <span class="text-muted-brasil small">Paiement sécurisé via Wave ou Orange Money</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="summary-card">
                    <h5 class="mb-4">Récapitulatif</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Sous-total</span>
                        <span class="fw-semibold">@Model.Panier.SousTotal.ToString("N0") FCFA</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Frais livraison</span>
                        <span class="fw-semibold">Calculés au checkout</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0">Total</span>
                        <span class="h4 text-brasil mb-0">@Model.Panier.SousTotal.ToString("N0") FCFA</span>
                    </div>
                    <div class="d-grid mt-4">
                        <a class="btn btn-brasil btn-lg" asp-controller="Checkout" asp-action="Index">Commander</a>
                    </div>
                    <p class="text-muted-brasil small mt-3 mb-0">Paiement sécurisé via Wave ou Orange Money</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="summary-card text-center">
            <i class="fas fa-shopping-cart fa-3x text-muted mb-4"></i>
            <h4 class="fw-semibold">Votre panier est vide</h4>
            <p class="text-muted-brasil">Découvrez nos délicieux burgers et menus !</p>
            <a asp-controller="Catalogue" asp-action="Index" class="btn btn-brasil btn-lg">Voir la carte</a>
        </div>
    }
</div>

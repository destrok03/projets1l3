@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="container py-5">
    <div class="text-center">
        <h1 class="display-1 text-warning">😕</h1>
        <h1 class="display-4">Oups !</h1>
        <p class="lead text-muted">Une erreur est survenue lors du traitement de votre demande.</p>
        
        @if (Model?.ShowRequestId ?? false)
        {
            <p class="text-muted"><small>Request ID: @Model?.RequestId</small></p>
        }
        
        <a asp-controller="Home" asp-action="Index" class="btn btn-brasil btn-lg mt-3">
            <i class="fas fa-home me-2"></i>Retour à l'accueil
        </a>
    </div>
</div>

@model PasserCommandeViewModel
@{
    ViewData["Title"] = "Passer commande";

    decimal fraisLivraison = Model.Panier.FraisLivraison;
    decimal sousTotal = Model.Panier.SousTotal;
    decimal total = sousTotal + fraisLivraison;
}

<div class="container py-5">
    <a asp-controller="Panier" asp-action="Index" class="link-back mb-4 d-inline-flex">
        <i class="fas fa-arrow-left"></i> Retour au panier
    </a>

    <form asp-action="Passer" method="post" class="row g-4">
        <div class="col-lg-7">

            <!-- Récap panier -->
            <div class="checkout-card mb-4">
                <div class="checkout-header">
                    <h2 class="fw-bold mb-0">Récapitulatif</h2>
                    <span class="text-muted-brasil">@Model.Panier.NombreItems article(s)</span>
                </div>

                @foreach (var item in Model.Panier.Items)
                {
                    <div class="checkout-item d-flex align-items-center">
                        <div class="flex-grow-1 ms-3">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h6>@item.Nom</h6>
                                    <small>x@item.Quantite</small>
                                </div>
                                <strong>@item.SousTotal.ToString("N0") FCFA</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Livraison -->
            <div class="checkout-card p-4">
                <h4 class="fw-bold mb-3">Mode de service</h4>

                <select asp-for="CommandeForm.QuartierId" class="form-select" id="quartierSelect">
                    <option value="">-- Sélectionner un quartier --</option>
                    @foreach (var q in Model.Quartiers)
                    {
                        <option value="@q.Id" data-frais="@q.Zone.PrixLivraison">
                            @q.Nom (@q.Zone.Nom)
                        </option>
                    }
                </select>

                <div class="mt-3">
                    Frais livraison :
                    <strong id="fraisLivraisonMontant">@fraisLivraison.ToString("N0")</strong> FCFA
                </div>
            </div>
        </div>

        <!-- Résumé -->
        <div class="col-lg-5">
            <div class="summary-card sticky-top" style="top:100px;">
                <h5>Total commande</h5>

                <div class="d-flex justify-content-between">
                    <span>Sous-total</span>
                    <span>@sousTotal.ToString("N0") FCFA</span>
                </div>

                <div class="d-flex justify-content-between">
                    <span>Livraison</span>
                    <span id="fraisRecap">@fraisLivraison.ToString("N0") FCFA</span>
                </div>

                <hr>

                <div class="d-flex justify-content-between fw-bold">
                    <span>Total</span>
                    <span id="totalRecap">@total.ToString("N0") FCFA</span>
                </div>

                <button type="submit" class="btn btn-brasil w-100 mt-4">
                    Continuer vers paiement
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
const sousTotal = @sousTotal;

const quartierSelect = document.getElementById("quartierSelect");
const fraisRecap = document.getElementById("fraisRecap");
const totalRecap = document.getElementById("totalRecap");
const fraisMontant = document.getElementById("fraisLivraisonMontant");

quartierSelect.addEventListener("change", () => {
    const selected = quartierSelect.options[quartierSelect.selectedIndex];
    const frais = selected.dataset.frais ? Number(selected.dataset.frais) : 0;

    fraisMontant.textContent = frais.toLocaleString("fr-FR");
    fraisRecap.textContent = frais.toLocaleString("fr-FR") + " FCFA";
    totalRecap.textContent = (sousTotal + frais).toLocaleString("fr-FR") + " FCFA";
});
</script>
}

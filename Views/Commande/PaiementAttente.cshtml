@model PaiementViewModel
@{
    ViewData["Title"] = "Paiement en cours";
}
<div class="container py-5 text-center">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-5">
            <div class="mb-4">
                <div class="spinner-border text-brasil" style="width: 4rem; height: 4rem;" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
            </div>
            <h2 class="fw-bold mb-3">Paiement en cours...</h2>
            <p class="lead">Montant : <strong>@Model.Commande.MontantTotal.ToString("N0") FCFA</strong></p>
            <p>Numéro : <strong>@Model.PaiementForm.NumeroTelephone</strong></p>
            <div id="confirmation-message" class="mt-4" style="display:none;">
                <h3 class="text-success">Paiement réussi !</h3>
                <p>Référence : <strong id="ref-paiement"></strong></p>
                <a asp-controller="Commande" asp-action="Confirmation" asp-route-id="@Model.Commande.Id" class="btn btn-brasil mt-3">Voir la commande</a>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    setTimeout(function() {
        // Génération d'une référence simulée
        const ref = "WV" + new Date().getFullYear() + (Math.random()*1e17).toFixed(0).substring(0,10);
        document.getElementById('ref-paiement').textContent = ref;
        document.getElementById('confirmation-message').style.display = 'block';
        document.querySelector('.spinner-border').style.display = 'none';
        document.querySelector('h2').textContent = 'Paiement réussi !';
    }, 2000);
</script>
}
@model ProfilViewModel
@{
    ViewData["Title"] = "Mon Profil";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4">
        <i class="fas fa-user-circle text-warning me-2"></i>Mon Profil
    </h2>

    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow">
                <div class="card-body text-center py-4">
                    <div class="bg-brasil rounded-circle d-inline-flex align-items-center justify-content-center mb-3" 
                         style="width: 100px; height: 100px;">
                        <i class="fas fa-user fa-3x text-white"></i>
                    </div>
                    <h4 class="mb-1">@Model.Client.NomComplet</h4>
                    <p class="text-muted mb-0">
                        <i class="fas fa-phone me-1"></i>@Model.Client.Telephone
                    </p>
                    @if (!string.IsNullOrEmpty(Model.Client.Email))
                    {
                        <p class="text-muted mb-0">
                            <i class="fas fa-envelope me-1"></i>@Model.Client.Email
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow mb-4">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0"><i class="fas fa-info-circle text-warning me-2"></i>Informations</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Nom</label>
                            <p class="fw-medium mb-0">@Model.Client.Nom</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Prénom</label>
                            <p class="fw-medium mb-0">@Model.Client.Prenom</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Téléphone</label>
                            <p class="fw-medium mb-0">@Model.Client.Telephone</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Email</label>
                            <p class="fw-medium mb-0">@(Model.Client.Email ?? "-")</p>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label text-muted small">Adresse</label>
                            <p class="fw-medium mb-0">@(Model.Client.Adresse ?? "-")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Quartier</label>
                            <p class="fw-medium mb-0">@(Model.Client.QuartierNom ?? "-")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Zone</label>
                            <p class="fw-medium mb-0">@(Model.Client.ZoneNom ?? "-")</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-receipt text-warning me-2"></i>Actions rapides</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Commande" asp-action="MesCommandes" class="btn btn-brasil">
                            <i class="fas fa-list me-2"></i>Mes commandes
                        </a>
                        <a asp-controller="Catalogue" asp-action="Index" class="btn btn-outline-brasil">
                            <i class="fas fa-utensils me-2"></i>Commander
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
